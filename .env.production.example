APP_NAME="Omset Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://omsetdigital.com

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Session / Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# Queue
QUEUE_CONNECTION=sync

# Octane / FrankenPHP
OCTANE_SERVER=frankenphp
FRANKENPHP_WORKERS=auto

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_SCHEME=ssl
MAIL_FROM_ADDRESS="halo@omsetdigital.com"
MAIL_FROM_NAME="Omset Digital"

# Storage (local — public uploads served via symlink)
FILESYSTEM_DISK=local
